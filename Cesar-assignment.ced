STACKPT: EQU 65408
IVET:	EQU 65470
TIMD:	EQU 65495
INTS: 	EQU 65496
INTE: 	EQU 65497
TECST: 	EQU 65498
TECDT: 	EQU 65499 
VISOR:	EQU 65500

	CLR, INTS
	CLR, TECST
	CLR, TECDT
	MOV, #ISR, IVET
	MOV, #130, INTE 	;Ativa as interrupções de teclado apenas [1]0000[1]0
	MOV, #STACKPT, R6	;;Inicia a pilha

inicio: TST, ACTIVED_ROBOTS ;;Se ACTIVED_ROBOTS != 0, EXECUTA O PROGRAMA
	BNE, main
	JSR, R7,JSR_MSG01
	JMP, inicio
	

main:
	JSR, R7, JSR_CVISOR
	JSR, R7, JSR_MSG02
	JMP, wait_command
	
	






ORG 6000 
;==================================================
;	      	WAIT_COMMAND
;==================================================
wait_command:
wc_loop:
	MOV, R0,R0
	JMP, wc_loop

;==================================================
;	      MENSAGEM: ROBOS PARADOS
;==================================================
JSR_MSG01:
	CLR, INTE		;Desabilita as interruções de hardware
	MOV, #MESSAGE01, R1	;R1 contém o primeiro endereço da string MESSAGE01
	MOV, #VISOR, R2		;R2 contém o primeiro endereço do VISOR
loop:	CMP,(R1), #47		;Verifica se está na última posição da string "\'
	BEQ,out			;Se z = 1, a última possição da string foi alcançada
	MOV,(R1)+, (R2)
	INC,R2
	JMP, loop

out:	
	MOV, #130, INTE	
	RTS, R7

;==================================================
;	      MENSAGEM: ROBO X:
;==================================================
JSR_MSG02:
	MOV, #MESSAGE02, R1	;R1 contém o primeiro endereço da string MESSAGE02
	MOV, #VISOR, R2		;R2 contém o primeiro endereço do VISOR
loop1:	CMP,(R1), #47		;Verifica se está na última posição da string "\"
	BEQ,out_msg02		;Se z = 1, a última possição da string foi alcançada
	CMP,(R1), #42		;Verifica se é o caractere "*"
	BNE, go
	
	MOV,CURRENT_ROBOT, R0	
	ADD,#48, R0		;Transforma o número de current_robot em codificação ASCII
	MOV,R0, (R2)		;Coloca o current_robot na posição demarcada pelo caractere "*"
	INC,R2
	ADD, #2, R1		;Incrementa o ponteiro da string MESSAGE02
go:	MOV,(R1)+, (R2)		
	INC,R2
	JMP, loop1
out_msg02:
	RTS, R7

;==================================================
;	JSR_ROBOT:
;==================================================
JSR_ROBOT:
	
	

;==================================================
;	ISR: REAÇÃO AO TECLADO & TIMER
;==================================================
ISR:
	clr,INTE		;Desabilita as interrupções de hardware
	clr, TECST		;Limpa a flag do teclado
	JSR, R7, jsr_rx_out	;Salva o conteudo dos registradores na memoria

	MOV,INTS, R0
	AND,MASK_TCL, R0	;Verifica se a interrupção foi gerada pelo teclado
	CMP,R0,#2		
	BEQ,J_TCL		;Pula para o tratamento de interrupção do teclado
	
	JSR, R7, JSR_TIMER	;Pula para o tratamento da interrupção de timer
	
return:	
	JSR,R7, jsr_rx_in	;Retorna para os registradores o seu conteudo
	MOV, MASK_CL, INTS	;Seta INTS pra [1]000000
	MOV, #130, INTE 	;Ativa as interrupções de teclado e timer
	RTI	



;==================================================
;	J_TCL: Interrupção pelo teclado
;==================================================

J_TCL:
	CMP,TECDT, #78		
	BEQ, subrout_n
	CMP,TECDT, #110
	BEQ, subrout_n

subrout_n:
	JSR,R7, jsr_n
	JMP, return

;==================================================
;	JSR_TIMER: Interrupção pelo timer
;==================================================
JSR_TIMER:
	
;==================================================
;JSR_N: TRATA A INTERRUPÇÃO ATIVADA PELA TECLA "N" OU "n"
;==================================================	
JSR_N:
	INC,ACTIVED_ROBOTS	;;Incrementa o contador 
	ADD, #1, CURRENT_ROBOT	;;Seta o robo atual para
	JSR, R7, JSR_CVISOR	;;Limpa o visor
	RTS, R7

;==================================================
;		LIMPA O VISOR
;==================================================

JSR_CVISOR:

	MOV, #31, R0 ;;TAMANHO DA FRASE
	MOV, #VISOR, R2
loopVisor:

	TST, R0
	BEQ, out_cvisor
	CLR,(R2)
	DEC, R0
	INC, R2
	JMP, loopVisor
out_cvisor:

	RTS, R7


;==================================================
;	  SALVA REGISTRADORES NA MEMORIA
;==================================================
jsr_rx_out:
	MOV, R0, bkp_R0
	MOV, R1, bkp_R1
	MOV, R2, bkp_R2
	MOV, R3, bkp_R3
	RTS, R7


;==================================================
;	  TIRA OS REGISTRADORES DA MEMORIA
;==================================================
jsr_rx_in:
	MOV, bkp_R0, R0
	MOV, bkp_R1, R1
	MOV, bkp_R2, R2
	MOV, bkp_R3, R3
	RTS, R7

;==================================================

ORG 30000
ACTIVED_ROBOTS: dw 0
CURRENT_ROBOT: dw 0

MASK_CL: dw 128
MASk_TCL: dw 2
MASK_TIM: dw 1

MESSAGE01: daw 'ROBOS PARADOS/'
MESSAGE02: daw 'ROBO *:/'
MESSAGE03: daw 'NAO HA ROBOS LIVRES/'

bkp_R0: dw 0
bkp_R1: dw 0
bkp_R2: dw 0
bkp_R3: dw 0

;==================================================
;Vetor de 4 posições, responsável por armazenar as 
;posições X e Y de cada robô. (Para acessar o 
;endereço usa #BOTS_POSI... acessar o conteúdo usa BOTS_POS...)

BOTS_POSITIONS_X: daw [4]	
BOTS_POSITIONS_Y: daw [4]
;==================================================


;==================================================
;Vetor de 4 posições, responsável por armazenar as 
;velocidades nos eixos X e Y de cada robô. (Para acessar o 
;endereço usa #BOTS_POSI... acessar o conteúdo usa BOTS_POS...)

BOTS_VEL_X: daw [4]
BOTS_VEL_Y: daw [4]
;==================================================
;Vetor de 4 posições, responsável por guardar a flag
;de ativação dos robos.
BOTS: daw [4]
;==================================================