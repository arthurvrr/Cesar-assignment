STACKPT: EQU 65408
IVET:	EQU 65470
TIMD:	EQU 65495
INTS: 	EQU 65496
INTE: 	EQU 65497
TECST: 	EQU 65498
TECDT: 	EQU 65499 
VISOR:	EQU 65500

	CLR, INTS
	CLR, TECST
	CLR, TECDT
	MOV, #ISR_KEY, IVET
	MOV, #130, INTE 		;;Ativa as interrupções de teclado e visor
	MOV, #STACKPT, R6	;;Inicia a pilha

inicio: TST, ACTIVED_ROBOTS ;;Se ACTIVED_ROBOTS != 0, EXECUTA O PROGRAMA
	BNE, main
	JSR, R7,JSR_MSG01
	JMP, inicio
	

main: 	HLT






ORG 6000 
;==================================================
;	      MENSAGEM: ROBOS PARADOS
;==================================================

JSR_MSG01:
	MOV, #MESSAGE01, R1	;R1 contém o primeiro endereço da string MESSAGE01
	MOV, #VISOR, R2		;R2 contém o primeiro endereço do VISOR
loop:	CMP,(R1), #47		;Verifica se está na última posição da string "\'
	BEQ,out			;Se z = 1, a última possição da string foi alcançada
	MOV,(R1)+, (R2)
	INC,R2
	JMP, loop
out:	RTS, R7


	
;==================================================
;	JSR_ROBOT:
;==================================================


;==================================================
;	ISR: REAÇÃO AO TECLADO
;==================================================

ISR_KEY:
	CMP,TECDT, #78
	BEQ,JSR_N
	CMP,TECDT, #110
	BEQ,JSR_N
	
	RTI

JSR_N:
	INC,ACTIVED_ROBOTS	;;Incrementa o contador 
	ADD, #1, CURRENT_ROBOT	;;Seta o robo atual para
	JSR, R7, JSR_CVISOR

	HLT			;;Implementar a condinuação do programa
;==================================================
;   JSR_AUX: NÚMERO DO ROBO NO VISOR NA JSR_MSG02
;==================================================
	
JSR_13:
	ADD,#48, CURRENT_ROBOT
	MOV,CURRENT_ROBOT, (R1)	
	SUB,#48,CURRENT_ROBOT
	RTS, R7

;==================================================
;		LIMPA O VISOR
;==================================================

JSR_CVISOR:
	MOV, #31, R0 ;;TAMANHO DA FRASE
	MOV, #VISOR, R2
loopVisor:
	TST, R0
	BEQ, out
	CLR,(R2)
	DEC, R0
	INC, R2
	JMP, loopVisor
	






ORG 30000
ACTIVED_ROBOTS: dw 0
CURRENT_ROBOT: dw 0
MESSAGE01: daw 'ROBOS PARADOS/'
MESSAGE03: daw 'NAO HA ROBOS LIVRES/'

;==================================================
;Vetor de 4 posições, responsável por armazenar as 
;posições X e Y de cada robô. (Para acessar o 
;endereço usa #BOTS_POSI... acessar o conteúdo usa BOTS_POS...)

BOTS_POSITIONS_X: daw [4]	
BOTS_POSITIONS_Y: daw [4]
;==================================================


;==================================================
;Vetor de 4 posições, responsável por armazenar as 
;velocidades nos eixos X e Y de cada robô. (Para acessar o 
;endereço usa #BOTS_POSI... acessar o conteúdo usa BOTS_POS...)

BOTS_VEL_X: daw [4]
BOTS_VEL_Y: daw [4]
;==================================================


