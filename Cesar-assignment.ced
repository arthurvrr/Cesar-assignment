STACKPT: EQU 65408
IVET:	EQU 65470
TIMD:	EQU 65495
INTS: 	EQU 65496
INTE: 	EQU 65497
TECST: 	EQU 65498
TECDT: 	EQU 65499 
VISOR:	EQU 65500
POS_Y:  EQU 65507
POS_Y_SIGNAL: EQU 65510
POS_X:  EQU 65515
POS_X_SIGNAL: EQU 65517
POS_vY:  EQU 65523
POS_vY_SIGNAL: EQU 65525
POS_vX:  EQU 65530
POS_vX_SIGNAL: EQU 65531  
 

	CLR, INTS
	CLR, TECST
	CLR, TECDT
	CLR, TIMD
	MOV, #ISR, IVET
	MOV, #130, INTE 	;Ativa as interrup??es de teclado apenas [1]0000[1]0
	MOV, #STACKPT, R6		;Inicia a pilha

inicio: 
	
	TST, ACTIVED_ROBOTS 	;Se ACTIVED_ROBOTS != 0, EXECUTA O PROGRAMA
	BNE, main
	JSR, R7,JSR_MSG01
	JMP, inicio
	

main:
	;MOV, #131, INTE		;Habilita as interrupções de timer
	JSR, R7, JSR_CVISOR		;Limpa o visor
	JMP, wait_command

ORG 6000 
;==================================================
;	      	WAIT_COMMAND
;==================================================
wait_command:
	TST, ACTIVED_ROBOTS
	BNE, go_wc
	JMP, inicio
go_wc:	TST, FLAG_TIMER
	BEQ, jmp_wc			;Se z = 1, FLAG_TIMER  = 0
	JSR, R7, JSR_MSG03		;Mostra a mensagem "Nao ha robos livres"
	JMP,wait_command	
jmp_wc:
	JSR, R7, JSR_MSG02
	JMP, wait_command

;==================================================
;	      MENSAGEM: ROBOS PARADOS
;==================================================
JSR_MSG01:
	CLR, INTE		;Desabilita as interru??es de hardware
	MOV, #MESSAGE01, R1	;R1 cont?m o primeiro endere?o da string MESSAGE01
	MOV, #VISOR, R2		;R2 cont?m o primeiro endere?o do VISOR

loop:	
	CMP,(R1), #47		;Verifica se est? na ?ltima posi??o da string "\'
	BEQ,out			;Se z = 1, a ?ltima possi??o da string foi alcan?ada
	MOV,(R1)+, (R2)
	INC,R2
	JMP, loop

out:	
	MOV, #130, INTE		;Habilita as interrupções de teclado novamente
	RTS, R7
;==================================================
;	   MENSAGEM: NÃO HA ROBOS LIVRES
;==================================================
JSR_MSG03:
	TST, MSG_TIMER
	BEQ, flag_flip
	CLR, INTE		;Desabilita as interru??es de hardware
	MOV, #MESSAGE03, R1	;R1 cont?m o primeiro endere?o da string MESSAGE03
	MOV, #VISOR, R2		;R2 cont?m o primeiro endere?o do VISOR

loop_msg03:	
	CMP,(R1), #47		;Verifica se est? na ?ltima posi??o da string "\'
	BEQ,out_msg03			;Se z = 1, a ?ltima possi??o da string foi alcan?ada
	MOV,(R1)+, (R2)
	INC,R2
	JMP, loop_msg03

flag_flip:
	CLR, FLAG_TIMER		;Seta para zero a flag_timer quando MSG_TIMER = 0
out_msg03:
	MOV, #131, INTE		;Habilita as interrupções de teclado e timer
	RTS, R7
	
;==================================================
;	      MENSAGEM: ROBO X:
;==================================================
JSR_MSG02:
	MOV, #MESSAGE02, R1	;R1 contem o primeiro endere?o da string MESSAGE02
	MOV, #VISOR, R2		;R2 contem o primeiro endere?o do VISOR

loop_msg02:
	CMP,(R1), #47		;Verifica se est? na ultima posi??o da string "\"
	BEQ,out_msg02		;Se z = 1, a ?ltima possi??o da string foi alcan?ada
	CMP,(R1), #42		;Verifica se ? o caractere "*"
	BNE, go
	
	JSR, R7, JSR_POSITION	;Coloca as strings "X:", "Y:" , "vX:" e "vY:" no visor
	
	MOV,CURRENT_ROBOT, R0	;Salva o robo atual em R0	
	ADD,#48, R0		;Transforma o numero de current_robot em codifica??o ASCII
	MOV,R0, (R2)		;Coloca o current_robot na posi??o demarcada pelo caractere "*"
	INC,R2
	ADD, #2, R1		;Incrementa o ponteiro da string MESSAGE02
go:	MOV,(R1)+, (R2)		
	INC,R2
	JMP, loop_msg02

	 
	
out_msg02:
	
	MOV, #BOTS_POSITIONS_Y, R1	;Coloca o endereço do inicio do vetor em R1
	MOV, CURRENT_ROBOT, R0		;Robo atual
	ASL, R0				;
	SUB, #2, R0			; (2 * CURRENT_ROBOT) - 2
	ADD, R0, R1			;Move o ponteiro para o endereco do CURRETN_ROBOTS
	MOV, #POS_Y,R2			;Coloca em R2 o endereço de inicio da string.
	
	ADD, #6, R2			;Solução momentanea para o problema do digito
	MOV,#32, (R2)			;vestigial na troca e negativo para positivo.
	SUB, #6, R2			;Funciona, mas deixa a última posição piscando
	
	ADD, #3, R2
	MOV, (R1),-(R6)			;Empilha o VALOR do número 'n'(BOT_POSITION_X)
	MOV, R2,-(R6)			;Empilha o endereço do visor
	JSR, R7, int2str		
	ADD, #4 ,R6			;Limpar pilha

	MOV, #BOTS_POSITIONS_X, R1	;Coloca o endereço do inicio do vetor em R1
	MOV, CURRENT_ROBOT, R0		;Robo atual
	ASL, R0				;
	SUB, #2, R0			; (2 * CURRENT_ROBOT) - 2
	ADD, R0, R1			;Move o ponteiro para o endereco do CURRETN_ROBOTS
	MOV, #POS_X,R2			;Coloca em R2 o endereço de inicio da string.
	
	ADD, #6, R2			;Solução momentanea para o problema do digito
	MOV,#32, (R2)			;vestigial na troca e negativo para positivo.
	SUB, #6, R2			;Funciona, mas deixa a última posição piscando

	ADD, #3, R2
	MOV, (R1),-(R6)			;Empilha o VALOR do número 'n'(BOT_POSITION_X)
	MOV, R2,-(R6)			;Empilha o endereço do visor
	JSR, R7, int2str		
	ADD, #4 ,R6			;Limpar pilha
	
	MOV, #BOTS_VEL_X, R1	;Coloca o endereço do inicio do vetor em R1
	MOV, CURRENT_ROBOT, R0		;Robo atual
	ASL, R0				;
	SUB, #2, R0			; (2 * CURRENT_ROBOT) - 2
	ADD, R0, R1			;Move o ponteiro para o endereco do CURRETN_ROBOTS
	MOV, #POS_vX,R2			;Coloca em R2 o endereço de inicio da string.
	
	ADD, #5, R2			;Solução momentanea para o problema do digito
	MOV,#32, (R2)			;vestigial na troca e negativo para positivo.
	SUB, #5, R2			;Funciona, mas deixa a última posição piscando

	ADD, #4, R2
	MOV, (R1),-(R6)			;Empilha o VALOR do número 'n'(BOT_POSITION_X)
	MOV, R2,-(R6)			;Empilha o endereço do visor
	JSR, R7, int2str_vel		
	ADD, #4 ,R6			;Limpar pilha

	MOV, #BOTS_VEL_Y, R1	;Coloca o endereço do inicio do vetor em R1
	MOV, CURRENT_ROBOT, R0		;Robo atual
	ASL, R0				;
	SUB, #2, R0			; (2 * CURRENT_ROBOT) - 2
	ADD, R0, R1			;Move o ponteiro para o endereco do CURRETN_ROBOTS
	MOV, #POS_vY,R2			;Coloca em R2 o endereço de inicio da string.
	
	ADD, #5, R2			;Solução momentanea para o problema do digito
	MOV,#32, (R2)			;vestigial na troca e negativo para positivo.
	SUB, #5, R2			;Funciona, mas deixa a última posição piscando

	ADD, #4, R2
	MOV, (R1),-(R6)			;Empilha o VALOR do número 'n'(BOT_POSITION_X)
	MOV, R2,-(R6)			;Empilha o endereço do visor
	JSR, R7, int2str_vel		
	ADD, #4 ,R6			;Limpar pilha


	RTS, R7

;==================================================
; JSR_POSITION:
;==================================================
JSR_POSITION:
	MOV, #POS_X, R0
	MOV, #88,(R0)
	INC, R0
	MOV,  #58, (R0)

	MOV, #POS_Y, R0
	MOV, #89,(R0)
	INC, R0
	MOV,  #58, (R0)
	
	MOV, #POS_vY, R0
	MOV, #118, (R0)
	INC, R0
	MOV, #89, (R0)
	INC, R0
	MOV,  #58, (R0)
	
	MOV, #POS_vX, R0
	MOV, #118, (R0)
	INC, R0
	MOV, #88, (R0)
	INC, R0
	MOV,  #58, (R0)
	
	RTS, R7

;==================================================
;	ISR: REACAO AO TECLADO & TIMER
;==================================================
ISR:
	clr,INTE		;Desabilita as interrup??es de hardware
	clr, TECST		;Limpa a flag do teclado
	JSR, R7, jsr_rx_out	;Salva o conteudo dos registradores na memoria

	MOV,INTS, R0
	AND,MASK_TCL, R0	;Verifica se a interrup??o foi gerada pelo teclado
	CMP,R0,#2		
	BEQ,J_TCL		;Pula para o tratamento de interrup??o do teclado

	INC, TIMER_COUNT	;Incrementa o contador de timer

	MOV, FLAG_TIMER, R0	;Verifica se FLAG_TIMER = 1
	TST, R0
	BEQ, go_isr		;Se z = 1, FLAG_TIMER = 0, pula pra continuação
	DEC, MSG_TIMER		;Decrementa em 100 ms.

	
go_isr:
	CMP, #10, TIMER_COUNT	;Verifica se já foram feitas 10 interrupções(1 seg)
	BNE, return_isr		;Se não forem feitas 10 interrupções, pula para o final	
	JSR, R7, JSR_TIMER	;Pula para o tratamento da interrup??o de timer
	
return_isr:
	CLR,TECDT	
	JSR,R7, jsr_rx_in	;Retorna para os registradores o seu conteudo
	MOV, MASK_CL, INTS	;Seta INTS pra [1]000000
	MOV, #131, INTE 	;Ativa as interrup??es de teclado e timer
	RTI	



;==================================================
;	J_TCL: Interrupcao pelo teclado
;==================================================

J_TCL:
	CMP,TECDT, #78		;Verifica se "N" ou "n" foi apertado			
	BEQ, subrout_n
	CMP,TECDT, #110
	BEQ, subrout_n

	CMP,TECDT, #82		;Verifica se "R" ou "r" foi apertado			
	BEQ, subrout_r
	CMP,TECDT, #114
	BEQ, subrout_r

	CMP,TECDT, #87		;Verifica se "W" ou "w" foi apertado			
	BEQ, subrout_w
	CMP,TECDT, #119
	BEQ, subrout_w

	CMP,TECDT, #83		;Verifica se "S" ou "s" foi apertado			
	BEQ, subrout_s
	CMP,TECDT, #115
	BEQ, subrout_s
	
	CMP,TECDT, #65		;Verifica se "A" ou "a" foi apertado			
	BEQ, subrout_a
	CMP,TECDT, #97
	BEQ, subrout_a
	
	CMP,TECDT, #68		;Verifica se "D" ou "d" foi apertado			
	BEQ, subrout_d
	CMP,TECDT, #100
	BEQ, subrout_d
	
	CMP,TECDT, #49		;Verifica se as teclar 1,2,3 ou 4 foram apertadas		
	BEQ, subrout_number
	CMP,TECDT, #50
	BEQ, subrout_number
	CMP,TECDT, #51					
	BEQ, subrout_number
	CMP,TECDT, #52
	BEQ, subrout_number
	
	JMP, return_isr		;Caso a tecla apertada for inválida, retorna ao programa principal
;==================================================

subrout_n:			;Tratra da tecla "N" ou "n"
	JSR,R7, jsr_n
	JMP, return_isr

subrout_number:
	JSR,R7, jsr_number
	JMP, return_isr

subrout_r:			;Trata a tecla "r" ou "R"
	JSR,R7, jsr_r
	JMP, return_isr

subrout_w:			;Tratra da tecla "W" ou "w"
	MOV, #BOTS_VEL_Y, R0	;Passa o endereço da primeira posição de BOTS_VEL_Y para R0
	JSR,R7, jsr_inc_vel	;Pula para suborotina que altera a posição o conteudo do vetor passado para R0
	JMP, return_isr

subrout_s:			;Tratra da tecla "S" ou "s"
	MOV, #BOTS_VEL_Y, R0	;Passa o endereço da primeira posição de BOTS_VEL_Y para R0
	JSR,R7, jsr_dec_vel	;Pula para suborotina que altera a posição o conteudo do vetor passado para R0
	JMP, return_isr

subrout_a:			;Tratra da tecla "A" ou "a"
	MOV, #BOTS_VEL_X, R0	;Passa o endereço da primeira posição de BOTS_VEL_Y para R0
	JSR,R7, jsr_dec_vel	;Pula para suborotina que altera a posição o conteudo do vetor passado para R0
	JMP, return_isr

subrout_d:			;Tratra da tecla "D" ou "d"
	MOV, #BOTS_VEL_X, R0	;Passa o endereço da primeira posição de BOTS_VEL_Y para R0
	JSR,R7, jsr_inc_vel	;Pula para suborotina que altera a posição o conteudo do vetor passado para R0
	JMP, return_isr

;==================================================
;JSR_INC_VEL: Responsável por incementar o conteudo
;apontado por R0. Essa subroutina é usada tanto
;para o eixo X e Y.
;==================================================
JSR_INC_VEL:
	TST, ACTIVED_ROBOTS
	BEQ, out_jsr_inc_vel

	MOV, CURRENT_ROBOT, R1	;Move o robo atual para R1
	ASL, R1			;Duplica o valor de R1(CURRENT_ROBOT) em para saber quantas posições de memoria é preciso avançar
	SUB, #2, R1		;R1 = (2 * CURRENT_ROBOT) - 2
	ADD, R1, R0		;Move o ponteiro do vetor R0 em R1 endereços
	INC, (R0)		;Incrementa em 1 o conteudo apontado por R0, que é o enedereço da velocidade Y do robo atual.

out_jsr_inc_vel:
	RTS, R7

;==================================================
;JSR_DEC_VEL: Responsável por decrementar o conteudo
;apontado por R0. Essa subroutina é usada tanto
;para o eixo X e Y.
;==================================================
JSR_DEC_VEL:
	TST, ACTIVED_ROBOTS
	BEQ, out_jsr_inc_vel

	MOV, CURRENT_ROBOT, R1	;Move o robo atual para R1
	ASL, R1			;Duplica o valor de R1(CURRENT_ROBOT) em para saber quantas posições de memoria é preciso avançar
	SUB, #2, R1		;R1 = (2 * CURRENT_ROBOT) - 2
	ADD, R1, R0		;Move o ponteiro do vetor R0 em R1 endereços
	DEC, (R0)		;Decrementa em 1 o conteudo apontado por R0, que é o enedereço da velocidade Y do robo atual.

out_jsr_dec_vel:
	RTS, R7
	
;==================================================
;	JSR_TIMER: Interrupcao pelo timer
;==================================================
JSR_TIMER:
	CLR, R5				;R5 eh o apontador do ponteiro BOTS

loop_timer:
	CMP, R5, #8		;Verifica se todos os robos foram verificados
	BEQ, out_timer		;Se todos os robos foram verificados sai, da subrotina

	MOV, #BOTS, R0		;R0 contem o endereco de BOTS
	ADD, R5, R0		;Move o ponteiro de BOTS[n]
	TST, (R0)		;Levanda as flags
	BEQ, go_timer		;Se BOT[n] = 0, O robo nao esta ativo
	
	MOV, #BOTS_POSITIONS_X, R1	;R1 contem o endereço de BOTS_POS_X
	ADD, R5, R1			;Muda o ponteiro para BOTS_POS_X

	MOV, #BOTS_POSITIONS_Y, R2	;R2 contem o endereco de BOTS_POS_Y
	ADD, R5, R2			;Muda o ponteiro para BOTS_POS_Y

	MOV, #BOTS_VEL_X, R3		;R3 contem o endereco de BOTS_VEL_X
	ADD, R5, R3			;Muda o ponteiro para BOTS_VEL_X
	
	MOV, #BOTS_VEL_Y, R4		;R4 contem o endereco de BOTS_VEL_Y
	ADD, R5, R4			;Muda o ponteiro para BOTS_VEL_Y

	ADD, (R3),(R1)		;Soma R3 (VEL_X[n]) ao conteudo contido no endereço R1 (POS_X[N])
	ADD, (R4),(R2)		;Soma R4 (VEL_Y[n]) ao conteudo contido no endereço R2 (POS_Y[N])

go_timer:
	ADD, #2 , R5		;Incrementa o ponteiro
	JMP, loop_timer
		
out_timer:
	CLR, R5
	CLR, TIMER_COUNT
	RTS,R7

;==================================================
;JSR_N: TRATA A INTERRUPCAO ATIVADA PELA TECLA "N" OU "n"
;==================================================	
JSR_N:
	CLR, R1
	MOV, #BOTS, R0		;Coloco o endereco do vetor BOTS em R2

loop_jsr_n:
	TST, (R0)		;Levanda as flags de BOTS[N]	
	BEQ, active_bot		; Se z = 1, é possível ativar o robo nessa posicao	
	ADD, #2, R0		; Se z = 0, o robo já esta ativado, incrementa o ponteiro R0 
	INC, R1			; Incrementa o contador que verifica
	CMP, R1, #4		; Verifica se as 4 posicoes do vetor BOTS foram percorridas 		
	BEQ, max_bots		; Se todas as posicoes foram percorridas entao nao foi encontrado um robo livre
	JMP, loop_jsr_n		; Verifica as outras posicoes

active_bot:
	INC, ACTIVED_ROBOTS
	JSR, R7, clean_data	; Limpa os valores em BOTS_POSITION_X, BOTS_POSITION_Y, BOTS_VEL_X e BOTS_VEL_Y
	MOV, R1, CURRENT_ROBOT
	INC, CURRENT_ROBOT
	JMP, out_jsr_n
	
max_bots:
	JSR,R7,JSR_CVISOR
	MOV, #1, FLAG_TIMER	;Ativa a flag timer
	MOV, #20, MSG_TIMER	;Seta para 20 o contador, cada unidade representa 100 ms
	
out_jsr_n:	
	RTS, R7

;==================================================
;JSR_R: TRATA A INTERRUPCAO ATIVADA PELA TECLA "R" OU "r"
;==================================================
jsr_r:
	TST, ACTIVED_ROBOTS
	BEQ, out_jsr_r

	MOV, #BOTS, R1		;Move o endereco de BOTS para R1
	MOV, CURRENT_ROBOT, R0	;Coloca o robo atual em R0
	DEC, R0			;Decrementa em um para ajustar o ponteiro
	ASL, R0			;Dobra o valor para ajustar o ponteiro
	ADD, R0, R1		;Move o ponteiro de R1 em R0 posicoes
	CLR, (R1)		;Limpa a Flag de BOTS[N]
	DEC, CURRENT_ROBOT	;Decrementa CURRENT_ROBOT em 1 para mostrar no visor robo anteriror
	DEC, ACTIVED_ROBOTS	
	JSR, R7, jsr_cvisor	;Limpa o visor
	
out_jsr_r:
	RTS, R7

;==================================================
;	JSR_NUMBER: ALTERNA ENTRE OS ROBOS
;==================================================
jsr_number:
	TST, ACTIVED_ROBOTS
	BEQ, out_jsr_number
	
	MOV, #BOTS, R1
	MOV, TECDT, R0		;Move o digito pressionado para o teclado
	SUB, #48, R0
	ASL, R0			;Dobra o valor de R0
	SUB, #2, R0
	ADD, R0, R1		;Muda o ponteiro de BOTS[N]
	TST,(R1)		;Levanta as flagas da posicao BOTS[n]
	BEQ, out_jsr_number	;Se na posicao BOTS[N] tiver 0 (z = 1) nada é feito
	ADD, #2, R0
	ASR, R0
	MOV, R0, CURRENT_ROBOT
	
out_jsr_number:
	RTS, R7

;==================================================
;	LIMPA AS POSICOES E VELOCIDADES
;==================================================
clean_data:
	ASL, R1				;Dobra R1 para apontar para o robo correto (16 bits)
	
	MOV, #BOTS, R0			;Coloca o endereco de BOTS[N] em  R0
	ADD, R1, R0			;Muda o ponteiro
	CLR (R0)			;Limpa o conteudo em BOTS[N]
	ADD, #1, (R0)			;Coloca 1 em BOTS[N]

	MOV, #BOTS_POSITIONS_X, R0	;R0 contem o endereco de BOTS_POSITION_X	
	ADD, R1, R0			;Desloca o ponteiro de R0
	CLR, (R0)			;Limpa a posicao X
	MOV, #BOTS_POSITIONS_Y, R0
	ADD, R1, R0			;Desloca o ponteiro de R0
	CLR, (R0)			;Limpa a posicao Y

	MOV, #BOTS_VEL_Y, R0
	ADD, R1, R0			;Desloca o ponteiro de R0
	CLR, (R0)			;Limpa a velocidade Y
	MOV, #BOTS_VEL_X, R0
	ADD, R1, R0			;Desloca o ponteiro de R0
	CLR, (R0)			;Limpa a velocidade X
	
	ASR, R1
	RTS, R7

;==================================================
;		LIMPA O VISOR
;==================================================
JSR_CVISOR:

	MOV, #36, R0 ;;TAMANHO DA FRASE
	MOV, #VISOR, R2
loopVisor:

	TST, R0
	BEQ, out_cvisor
	CLR,(R2)
	DEC, R0
	INC, R2
	JMP, loopVisor
out_cvisor:

	RTS, R7


;==================================================
;	  SALVA REGISTRADORES NA MEMORIA
;==================================================
jsr_rx_out:
	MOV, R0, bkp_R0
	MOV, R1, bkp_R1
	MOV, R2, bkp_R2
	MOV, R3, bkp_R3
	RTS, R7


;==================================================
;	  TIRA OS REGISTRADORES DA MEMORIA
;==================================================
jsr_rx_in:
	MOV, bkp_R0, R0
	MOV, bkp_R1, R1
	MOV, bkp_R2, R2
	MOV, bkp_R3, R3
	RTS, R7

;==================================================
;	CONVERTE INTEIRO PARA STRING (POSICAO)
;==================================================
int2str:
	
	MOV 2(R6),R1 		;Coloca o endereco do visor(onde os caracteres comecam) no R1
	MOV 4(R6),R2		;Coloca o numero a ser convertido (Posicao) no R2
	BPL EhPositivo		;Verifica se R2 >= 0( N = 0 ), se sim, pula para EhPositivo
	
	NEG R2 			;Transforma o numero negativo em posito ( -123 -> 123 ) 		
	MOV, #'-', -1(R1)
	INC, R1

EhPositivo:
	MOV R2,-(R6) ; uint2str(s,n);
	MOV R1,-(R6)
	JSR R7,uint2str
	ADD #4,R6
	RTS R7

uint2str:
	MOV 2(R6),R1 ; R1 = s
	MOV 4(R6),R2 ; R2 = n
	MOV #Tab10,R4 ; pTab10 = Tab10;
	MOV #3,R5 ; Lacos = 3;

Loop_uint2str:
	MOV #'0',R3 ; dig = '0';

LoopInterno:
	CMP R2,(R4) ; while (n >= *pTab10) {
	BCS EhMenor
	INC R3 ; ++dig;
	SUB (R4),R2 ; n -= *pTab10;
	JMP LoopInterno ; }
	
EhMenor:
	MOV -1(R1),R0 		; *s++ = dig;
	AND #HFF00,R0
	OR R3,R0
	MOV R0,-1(R1)
	INC R1
	ADD #2,R4 		; ++pTab10;
	SOB R5,Loop_uint2str		; } while (--Lacos);
	ADD #'0',R2 		; *s++ = n + '0';
	MOV -1(R1),R0
	AND #HFF00,R0
	OR R2,R0
	MOV R0,-1(R1)
	INC R1

	RTS R7

;==================================================
;	CONVERTE INTEIRO PARA STRING (VELOCIDADE)
;==================================================
int2str_vel:
	MOV 2(R6),R1 ; s
	MOV 4(R6),R2 ; n
	BPL EhPositivo_vel ; if ( n < 0 ) {

	NEG R2 			;Transforma o numero negativo em posito ( -123 -> 123 ) 		
	MOV, #'-', -1(R1)
	INC, R1

EhPositivo_vel:
	MOV R2,-(R6) ; uint2str(s,n);
	MOV R1,-(R6)
	JSR R7,uint2str_vel
	ADD #4,R6
	RTS R7

uint2str_vel:
	MOV 2(R6),R1 ; R1 = s
	MOV 4(R6),R2 ; R2 = n
	MOV #Tab10_vel,R4 ; pTab10 = Tab10;
	MOV #1,R5 ; Lacos

Loop_uint2str_vel:
	MOV #'0',R3 ; dig = '0';

LoopInterno_vel:
	CMP R2,(R4) ; while (n >= *pTab10) {
	BCS EhMenor_vel
	INC R3 ; ++dig;
	SUB (R4),R2 ; n -= *pTab10;
	JMP LoopInterno_vel ; }
	
EhMenor_vel:
	MOV -1(R1),R0 		; *s++ = dig;
	AND #HFF00,R0
	OR R3,R0
	MOV R0,-1(R1)
	INC R1
	ADD #2,R4 		; ++pTab10;
	SOB R5,Loop_uint2str_vel		; } while (--Lacos);
	ADD #'0',R2 		; *s++ = n + '0';
	MOV -1(R1),R0
	AND #HFF00,R0
	OR R2,R0
	MOV R0,-1(R1)
	INC R1

	RTS R7

;==================================================

ORG 30000
ACTIVED_ROBOTS: dw 0
CURRENT_ROBOT: dw 0
TIMER_COUNT: dw 0
MSG_TIMER: dw 0
FLAG_TIMER: dw 0

MASK_CL: dw 128
MASk_TCL: dw 2
MASK_TIM: dw 1

MESSAGE01: daw 'ROBOS PARADOS                       /'
MESSAGE02: daw 'ROBO *:/'
MESSAGE03: daw 'NAO HA ROBOS LIVRES                 /'

bkp_R0: dw 0
bkp_R1: dw 0
bkp_R2: dw 0
bkp_R3: dw 0

Tab10: daw 1000, 100, 10
Tab10_vel: dw 10

;==================================================
;Vetor de 4 posi??es, respons?vel por armazenar as 
;posi??es X e Y de cada rob?. (Para acessar o 
;endere?o usa #BOTS_POSI... acessar o conte?do usa BOTS_POS...)

BOTS_POSITIONS_X: daw [4]	
BOTS_POSITIONS_Y: daw [4]

;==================================================
;Vetor de 4 posi??es, respons?vel por armazenar as 
;velocidades nos eixos X e Y de cada rob?. (Para acessar o 
;endere?o usa #BOTS_POSI... acessar o conte?do usa BOTS_POS...)

BOTS_VEL_X: daw [4]
BOTS_VEL_Y: daw [4]
;==================================================
;Vetor de 4 posi??es, respons?vel por guardar a flag
;de ativa??o dos robos.
BOTS: daw [4]
